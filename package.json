{
  "name": "@docuseal/signature-maker-react",
  "version": "1.1.0",
  "description": "React component for drawing, typing and uploading signatures",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "author": "DocuSeal <support@docuseal.com>",
  "license": "MIT",
  "repository": "https://github.com/docusealco/signature-maker-react",
  "homepage": "https://github.com/docusealco/signature-maker-react#readme",
  "bugs": {
    "url": "https://github.com/docusealco/signature-maker-react/issues"
  },
  "keywords": [
    "react-signature",
    "signature",
    "signature-drawing",
    "signature-pad"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node esbuild.config.js && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "prepublishOnly": "yarn build && yarn test"
  },
  "dependencies": {
    "@docuseal/signature-maker-js": "^1.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
